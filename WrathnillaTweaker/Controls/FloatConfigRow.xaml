<UserControl x:Class="WrathnillaTweaker.Controls.FloatConfigRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:WrathnillaTweaker.Converters"
             x:Name="Root"
             Margin="0,2">
    <UserControl.Resources>
        <conv:FloatToStringConverter x:Key="FloatConv"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Text="{Binding Label, ElementName=Root}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

        <TextBox Grid.Column="1"
                 Margin="0,0,8,0"
                 VerticalContentAlignment="Center">
            <TextBox.Text>
                <Binding Path="Value" ElementName="Root"
                         Converter="{StaticResource FloatConv}"
                         UpdateSourceTrigger="PropertyChanged"
                         NotifyOnValidationError="True">
                    <Binding.ValidationRules>
                        <conv:FloatValidationRule ValidationStep="RawProposedValue"/>
                    </Binding.ValidationRules>
                </Binding>
            </TextBox.Text>
        </TextBox>

        <ToggleButton x:Name="HelpBtn"
                      Grid.Column="2"
                      Content="?"
                      Width="20" Height="20"
                      Padding="0" FontSize="11"
                      VerticalAlignment="Center"/>
        <Popup Grid.Column="2"
               IsOpen="{Binding IsChecked, ElementName=HelpBtn}"
               PlacementTarget="{Binding ElementName=HelpBtn}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True">
            <Border Background="White" BorderBrush="#AAAAAA" BorderThickness="1"
                    Padding="8,6" MaxWidth="300">
                <TextBlock Text="{Binding Help, ElementName=Root}"
                           TextWrapping="Wrap" FontSize="11"/>
            </Border>
        </Popup>
    </Grid>
</UserControl>

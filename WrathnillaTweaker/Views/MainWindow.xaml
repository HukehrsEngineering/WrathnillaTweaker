<Window x:Class="WrathnillaTweaker.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:WrathnillaTweaker.Controls"
        xmlns:conv="clr-namespace:WrathnillaTweaker.Converters"
        Title="{Binding ConfigFileName}"
        Width="920" Height="700" MinWidth="640" MinHeight="400"
        Loaded="Window_Loaded">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Top toolbar -->
        <Border DockPanel.Dock="Top"
                BorderBrush="#DDDDDD" BorderThickness="0,0,0,1"
                Background="#F8F8F8" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Command="{Binding OpenFilePickerCommand}"
                            Padding="14,4" Margin="4,0">Load</Button>
                    <Button Command="{Binding SaveCommand}"
                            Padding="14,4" Margin="4,0">Save</Button>
                </StackPanel>
                <TextBlock Text="{Binding ConfigFileName}"
                           VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold"/>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom"
                BorderBrush="#DDDDDD" BorderThickness="0,1,0,0"
                Background="#F8F8F8" Padding="16,4">
            <TextBlock Text="{Binding Message}"
                       Foreground="#666666" FontSize="11"/>
        </Border>

        <!-- Main content -->
        <Grid>

            <!-- Shown when no config is loaded -->
            <TextBlock Text="Load a configuration file to begin"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="14" Foreground="#888888"
                       Visibility="{Binding IsConfigLoaded, Converter={StaticResource InverseBoolToVis}}"/>

            <!-- Config editor (shown when config is loaded) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsConfigLoaded, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="16" MaxWidth="820">

                    <!-- Skills -->
                    <GroupBox Header="Skills" Margin="0,0,0,12">
                        <StackPanel Margin="4,4,4,8">
                            <ctrl:IntConfigRow
                                Label="Max Trade Skills"
                                Value="{Binding Config.SkillConfig.MaxTradeSkills}"
                                Help="Maximum number of primary trade skills a character can learn&#10;Wrathnilla default: 11&#10;WotLK default: 2&#10;Rudegoblins Suggestion: 3 (This allows you to have the most relevant supplemental gathering skill for you primary crafting profession)"/>

                            <TextBlock Text="Skill Gains" Style="{StaticResource SectionLabel}"/>

                            <ctrl:IntConfigRow
                                Label="Crafting"
                                Value="{Binding Config.SkillConfig.SkillGains.Crafting}"
                                Help="Skill experience gained per crafting action&#10;Wrathnilla default: 5&#10;WotLK default: 1&#10;Rudegoblins Suggestion: 2"/>
                            <ctrl:IntConfigRow
                                Label="Gathering"
                                Value="{Binding Config.SkillConfig.SkillGains.Gathering}"
                                Help="Skill experience gained per gathering action&#10;Wrathnilla default: 5&#10;WotLK default: 1&#10;Rudegoblins Suggestion: 2"/>
                            <ctrl:IntConfigRow
                                Label="Defense"
                                Value="{Binding Config.SkillConfig.SkillGains.Defense}"
                                Help="Skill experience gained when taking damage&#10;Wrathnilla default: 5&#10;WotLK default: 1"/>
                            <ctrl:IntConfigRow
                                Label="Weapon"
                                Value="{Binding Config.SkillConfig.SkillGains.Weapon}"
                                Help="Skill experience gained per weapon skill use&#10;Wrathnilla default: 5&#10;WotLK default: 1"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Experience Rates -->
                    <GroupBox Header="Experience Rates" Margin="0,0,0,12">
                        <StackPanel Margin="4,4,4,8">
                            <ctrl:FloatConfigRow
                                Label="Kill"
                                Value="{Binding Config.ExperienceConfig.Kill}"
                                Help="Experience rate multiplier for killing mobs&#10;Wrathnilla default: 1&#10;WotLK default: 1&#10;Vanilla Like: 0.82 (This values correct for the reduced experience required with Wrath of the Lich King. It will result in a slower leveling speed that should match Vanilla)"/>
                            <ctrl:FloatConfigRow
                                Label="Quest"
                                Value="{Binding Config.ExperienceConfig.Quest}"
                                Help="Experience rate multiplier for quest completion&#10;Wrathnilla default: 1&#10;WotLK default: 1&#10;Vanilla Like: 0.82 (This values correct for the reduced experience required with Wrath of the Lich King. It will result in a slower leveling speed that should match Vanilla)"/>
                            <ctrl:FloatConfigRow
                                Label="Dungeon Finder"
                                Value="{Binding Config.ExperienceConfig.QuestDungeonFinder}"
                                Help="Experience rate multiplier for Dungeon Finder quests&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow
                                Label="Exploration"
                                Value="{Binding Config.ExperienceConfig.Exploration}"
                                Help="Experience rate multiplier for discovering new areas&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow
                                Label="Pet"
                                Value="{Binding Config.ExperienceConfig.Pet}"
                                Help="Experience rate multiplier for pet leveling&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                        </StackPanel>
                    </GroupBox>

                    <!-- Mob Stats -->
                    <GroupBox Header="Mob Stats" Margin="0,0,0,12">
                        <StackPanel Margin="4,4,4,8">

                            <TextBlock Text="Damage" Style="{StaticResource SectionLabel}"/>
                            <ctrl:FloatConfigRow Label="Normal"
                                Value="{Binding Config.DamageConfig.Damage.Normal}"
                                Help="Normal mob physical damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Elite"
                                Value="{Binding Config.DamageConfig.Damage.Elite}"
                                Help="Elite mob physical damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare"
                                Value="{Binding Config.DamageConfig.Damage.Rare}"
                                Help="Rare mob physical damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare Elite"
                                Value="{Binding Config.DamageConfig.Damage.RareElite}"
                                Help="Rare elite mob physical damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="World Boss"
                                Value="{Binding Config.DamageConfig.Damage.WorldBoss}"
                                Help="World boss physical damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>

                            <Separator Margin="0,8"/>

                            <TextBlock Text="Spell Damage" Style="{StaticResource SectionLabel}"/>
                            <ctrl:FloatConfigRow Label="Normal"
                                Value="{Binding Config.DamageConfig.SpellDamage.Normal}"
                                Help="Normal mob spell damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Elite"
                                Value="{Binding Config.DamageConfig.SpellDamage.Elite}"
                                Help="Elite mob spell damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare"
                                Value="{Binding Config.DamageConfig.SpellDamage.Rare}"
                                Help="Rare mob spell damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare Elite"
                                Value="{Binding Config.DamageConfig.SpellDamage.RareElite}"
                                Help="Rare elite mob spell damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="World Boss"
                                Value="{Binding Config.DamageConfig.SpellDamage.WorldBoss}"
                                Help="World boss spell damage multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>

                            <Separator Margin="0,8"/>

                            <TextBlock Text="Health" Style="{StaticResource SectionLabel}"/>
                            <ctrl:FloatConfigRow Label="Normal"
                                Value="{Binding Config.DamageConfig.Health.Normal}"
                                Help="Normal mob maximum HP multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Elite"
                                Value="{Binding Config.DamageConfig.Health.Elite}"
                                Help="Elite mob maximum HP multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare"
                                Value="{Binding Config.DamageConfig.Health.Rare}"
                                Help="Rare mob maximum HP multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="Rare Elite"
                                Value="{Binding Config.DamageConfig.Health.RareElite}"
                                Help="Rare elite mob maximum HP multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>
                            <ctrl:FloatConfigRow Label="World Boss"
                                Value="{Binding Config.DamageConfig.Health.WorldBoss}"
                                Help="World boss maximum HP multiplier&#10;Wrathnilla default: 1&#10;WotLK default: 1"/>

                        </StackPanel>
                    </GroupBox>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </DockPanel>
</Window>
